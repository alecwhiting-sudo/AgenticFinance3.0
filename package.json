{
  "name": "agenticfinance",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @af/api dev",
    "dev:web": "pnpm --filter @af/web dev",
    "dev:worker": "pnpm --filter @af/worker dev",
    "db:generate": "pnpm --filter @af/db generate",
    "db:migrate": "pnpm --filter @af/db migrate",
    "db:seed": "pnpm --filter @af/db seed",
    "seed:reset": "pnpm --filter @af/db seed:reset"
  }
}
