# Copy to .env for local dev. On Railway, set these per service with
# `railway variables` (DATABASE_URL comes from the Postgres plugin reference).

DATABASE_URL=postgresql://af:af@localhost:5432/agenticfinance

# Anthropic API (worker). Without a key the worker still runs — agents fall
# back to deterministic handlers, so the framework demos end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Services
PORT=3001                      # api (web 3000, worker 3002 locally)
API_URL=http://localhost:3001  # web (server) + worker -> api
NEXT_PUBLIC_API_URL=http://localhost:3001  # web (browser) -> api; on Railway, the api service's PUBLIC url
LOG_LEVEL=info

# Live experience pacing (ARCHITECTURE.md §6a): ms between visible agent steps.
# 0 = full speed; ~800 reads well in client demos.
WORKER_STEP_DELAY_MS=0
WORKER_POLL_MS=1500
