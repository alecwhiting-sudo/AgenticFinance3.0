# Copy to .env for local dev. On Railway, set these per service with
# `railway variables` (DATABASE_URL comes from the Postgres plugin reference).

DATABASE_URL=postgresql://af:af@localhost:5432/agenticfinance

# Anthropic API (worker only; unused until Phase 1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Services
PORT=3001                      # api (web uses 3000 locally)
API_URL=http://localhost:3001  # web + worker -> api
LOG_LEVEL=info
